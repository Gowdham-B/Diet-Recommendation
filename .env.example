# NutriPlan AI - Environment Configuration Example
# Copy this file to .env and adjust variables for your deployment environment.

# Database Configuration
# Default local SQLite database:
DATABASE_URL=sqlite:///nutriplan.db
# PostgreSQL production example:
# DATABASE_URL=postgresql://nutriuser:securepassword@localhost:5432/nutriplan_db

# Security & Session Secrets
SECRET_KEY=generate_a_secure_random_64_character_hex_key_for_production
DEV_MODE=True

# OpenID Connect (OIDC) Authentication (Optional: Google / Microsoft / Keycloak)
# Leave blank to use local secure PBKDF2-HMAC password authentication
OIDC_PROVIDER_URL=
OIDC_CLIENT_ID=
OIDC_CLIENT_SECRET=
OIDC_REDIRECT_URI=http://localhost:8501

# Machine Learning Artifacts
MODEL_ARTIFACTS_DIR=artifacts/models
METRICS_ARTIFACTS_DIR=artifacts/metrics
REPORTS_DIR=reports

# Application Settings
APP_NAME="NutriPlan AI"
APP_ENV=development
DEFAULT_SERVING_SCALE=1.0
ENABLE_FEEDBACK_LOGGING=True
